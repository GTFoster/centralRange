set.seed(1)
load("cleanData/metawebs.RDA")
load("cleanData/localwebs.RDA")
load("cleanData/metaCent.Rda")
load(file="cleanData/localwebs.RDA")
rm(InsectMeta, BirdMeta) #remove objects used for making these
load(file="cleanData/localCentrality.Rda")
imetaCent <- dplyr::select(imetaCent, -globkm, -envarea)
bmetaCent <- dplyr::select(bmetaCent, -globkm, -envarea)
localiCent <- dplyr::select(localiCent, -globkm, -envarea)
localbCent <- dplyr::select(localbCent, -globkm, -envarea)
matches <- read.csv(file="backbone_matches.csv")
georng_old <- read.csv(file="data/geosummaryout.csv")
georng <- read.csv(file="data/geosummaryout_M10.csv") %>% dplyr::rename(., node=verbatim_name) #joining column
geofill <- read.csv(file="data/geosummaryout_fill.csv") %>% dplyr::rename(., node=verbatim_name) #joining column
envrng_old <- read.csv(file="data/envsummaryout.csv")
envrng <- read.csv(file="data/envsummaryout_M10.csv") %>% dplyr::rename(., node=verbatim_name) #joining column
envfill <- read.csv(file="data/envsummaryout_fill.csv")%>% dplyr::rename(., node=verbatim_name) #joining column
envrng <- rbind(envrng, envfill)
georng <- rbind(georng, geofill)
georng <- georng %>%
dplyr::group_by(node, continent) %>%
dplyr::summarise(geoArea = max(contgeokm.area, na.rm = TRUE)) #If there are node naming descrepencies, resolve them using the most # of occ points
envrng <- envrng %>%
dplyr::group_by(node) %>%
dplyr::summarise(envarea = max(envarea, na.rm = TRUE)) #Same for environmental ranges
#imetaCent <- dplyr::select(imetaCent, -globkm, -envarea)
#bmetaCent <- dplyr::select(bmetaCent, -globkm, -envarea)
#localbCent <- dplyr::select(localbCent, -globkm, -envarea)
#localiCent <- dplyr::select(localiCent, -globkm, -envarea)
imetaCent <- left_join(imetaCent, envrng, by="node") #join environmental ranges
bmetaCent <- left_join(bmetaCent, envrng, by="node")
localiCent <- left_join(localiCent, envrng, by="node")
localbCent <- left_join(localbCent, envrng, by="node")
globgeo <- georng %>%
dplyr::group_by(., node) %>%
dplyr::summarise(., globkm=sum(geoArea)) #Combine individual continent ranges into single range size value
imetaCent <- left_join(imetaCent, globgeo, by="node") #join geographic ranges
bmetaCent <- left_join(bmetaCent, globgeo, by="node")
localiCent <- left_join(localiCent, globgeo, by="node") #many joins; that's ok (duplicates of species across range)
localbCent <- left_join(localbCent, globgeo, by="node")
rm(globgeo) #remove temporary object
imetaCent$net <- "Insect"
bmetaCent$net <- "Bird"
compositeMeta <- rbind(imetaCent, bmetaCent) %>% dplyr::filter(., is.na(envarea)==F)
compositeMeta$type[compositeMeta$type %in% c("Insect", "Bird")] <- "Floral Visitor"
missingI <- dplyr::filter(imetaCent, is.na(envarea)==T)
missingB <- dplyr::filter(bmetaCent, is.na(envarea)==T)
#Sig in geo raw: Visiting Insects, Insect-Visited Plants, Bird-Visited Plants
