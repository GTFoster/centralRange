sites <- dplyr::select(Birdweb, network_name, location_address, latitude, longitude) %>%
unique() %>%
dplyr::mutate(., type="Avian")
sites <- dplyr::select(Insectweb, network_name, location_address, latitude, longitude) %>%
unique() %>%
dplyr::mutate(., type="Insect") %>%
rbind(., sites)
world <- ggplot2::map_data("world")
ggplot() +
geom_polygon(data = world, aes(x=long, y = lat, group = group)) +
coord_fixed(1.3)+
theme_classic()+
geom_point(data=sites, aes(x=longitude, y=latitude, col=type))+
facet_grid(~type)+
xlab("Longitude")+
ylab("Latitude")+
labs(color = "Network Type")
pdf(file="cleanFigs/supplement/sitemap.pdf", width=8, height=5)
