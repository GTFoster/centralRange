ggplot(meta2, aes(x=log(nsites), y=close, col=turnover))+
geom_point()+
scale_color_viridis_c() +
theme_classic()
library(mgcv)
meta2turn <- meta2 %>% dplyr::filter(., is.na(turnover)==F & node!="Apis mellifera") #Only grab species that have turnover component (occur at multiple sites)
#gam_model <- mgcv::gam(formula=close~s(nsites, k = 2)+s(turnover), data=meta2turn)
meta2turn
mean(meta2turn$turnover)
load("gamtroubles.RDA")
#save(meta2turn, gam_model, new_data, file="gamtroubles.RDA")
gam_model <- mgcv::gam(close ~ te(nsites, turnover), data = meta2turn)
mgcv::gam.check(gam_model)
new_data <- expand.grid(nsites = seq(min(meta2turn$nsites), max(meta2turn$nsites), length=100),
turnover = quantile(meta2turn$turnover, c(0, 0.1,0.25,0.5,0.75,0.9, 1)))
new_data$pred <- predict(gam_model, new_data)
#pdf("figs/GAM_vis1.pdf")
ggplot(meta2turn, aes(x=nsites, y=close, col=turnover))+
geom_point()+
scale_x_log10()+
scale_color_viridis_c() +
theme_classic()+
theme_classic()+
geom_line(aes(x=nsites, y=pred, col=turnover, group=turnover), data=new_data)+
xlab("Number of sites (log scale)")+
ylab("Closeness Centrality in Global Metaweb")+
labs(color="Interaction Turnover")
#dev.off()
library(gratia)
meta2turn <- meta2 %>% dplyr::filter(., is.na(turnover)==F & node!="Apis mellifera") #Only grab species that have turnover component (occur at multiple sites)
#gam_model <- mgcv::gam(formula=close~s(nsites, k = 2)+s(turnover), data=meta2turn)
gam_close <- mgcv::gam(scale(close) ~ te(nsites, turnover), data = meta2turn)
gam_close.z <- mgcv::gam(scale(close.z) ~ te(nsites, turnover), data = meta2turn)
#pdf("figs/GAM_vis2.pdf")
gratia::draw(gam_close, select = 1, contour = TRUE)+
theme_classic()+
xlab("Number of sites (log scale)")+
ylab("Closeness Centrality in Global Metaweb")+
ggtitle("")
#dev.off()
draw(gam_close, select = 1, contour = TRUE, n = c(200, 200), too.far = 6) +
theme_classic()
library(gratia)
# Define extended ranges
newdat <- expand.grid(
nsites = seq(min(meta2turn$nsites), max(meta2turn$nsites), length = 500),
turnover = seq(min(meta2turn$turnover), max(meta2turn$turnover), length = 500)
)
# Extract smooth estimates
smooth_df <- gratia::smooth_estimates(gam_close, newdata = newdat)
# Extract smooth estimates
smooth_df.z <- gratia::smooth_estimates(gam_close.z, newdata = newdat)
# Plot manually
draw(smooth_df, contour = TRUE) +
theme_classic() +
xlab("Number of sites (log scale)") +
ylab("Closeness Centrality in Global Metaweb")
# Plot manually
draw(smooth_df.z, contour = TRUE) +
theme_classic() +
xlab("Number of sites (log scale)") +
ylab("Closeness Centrality in Global Metaweb")
#pdf("figs/GAM_vis2.pdf")
gamplot <- gratia::draw(gam_close, select = 1, contour = TRUE, n = c(400,400), dist = 0.15) +
theme_classic() +
xlab("Number of sites (log scale)") +
ylab("Relative Closeness Centrality\nin Global Metaweb") +
ggtitle("") +
scale_fill_gradientn(colors=c("lightblue","white", "firebrick"), limits = c(-4, 4), na.value = "gray97")+
theme(legend.position = c(0.95, 0.06),
legend.justification = c("right", "bottom"),
legend.background = element_rect(fill = alpha("gray97", 0.8), colour = NA),
legend.key.height = unit(0.2, "in"),
legend.key.width = unit(0.2, "in"))
# dev.off()
gamzplot <- gratia::draw(gam_close.z, select = 1, contour = TRUE, n = c(400,400), dist = 0.15) +
theme_classic() +
xlab("Number of sites (log scale)") +
ylab("Relative Z-transformed Closeness Centrality\nin Global Metaweb") +
ggtitle("")+
scale_fill_gradientn(colors=c("lightblue","white", "firebrick"), limits = c(-4, 4), na.value = "gray97")+
theme(legend.position = c(0.95, 0.06),
legend.justification = c("right", "bottom"),
legend.background = element_rect(fill = alpha("gray97", 0.8), colour = NA),
legend.key.height = unit(0.2, "in"),
legend.key.width = unit(0.2, "in"))
