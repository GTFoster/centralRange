imeta2 <- localiCent %>%
group_by(., node) %>%
dplyr::summarise(., localclose=mean(close), localclosesd=sd(close)) %>%
left_join(imetaCent, ., by="node")
bmeta2 <- localbCent %>%
group_by(., node) %>%
dplyr::summarise(., localclose=mean(close), localclosesd=sd(close)) %>%
left_join(bmetaCent, ., by="node")
meta2 <- rbind(bmeta2, imeta2)
meta2$combo <- paste(meta2$net, meta2$type, sep="-")
supp.labs <- c("Bird-Pollinated Plants", "Bird Floral Visitors", "Insect-Pollinated Plants", "Insect Floral Visitors")
names(supp.labs) <- c("Bird-Plant", "Bird-Bird", "Insect-Plant", "Insect-Insect")
#pdf(file="Scratch_turnoverplot.pdf", width=8, height=8)
meta2 %>%
dplyr::filter(., nsites>2 & is.na(globkm)==F) %>%
ggplot(., aes(x = turnover,
y = scale(close) - scale(localclose),
color = log(globkm)))+
geom_rect(aes(xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = 0),
fill = "lightcoral", col="black")+
geom_rect(aes(xmin = -Inf, xmax = Inf, ymin = 0, ymax = Inf),
fill = "lightblue", col="black") +
geom_point() +
geom_smooth(method = "lm") +
scale_color_viridis_c() +
labs( x = "Interaction Turnover",
color = "Range size (log km²)")+
theme_classic()+
facet_wrap(~combo, labeller = as_labeller(supp.labs))+
ylab(expression("Scaled Metaweb Centrality - Scaled Mean Local Centrality")) #IDK why it keeps cutting this off, but using expression to force prevent that from happening
