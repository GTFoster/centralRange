gamzplot <- gratia::draw(gam_close.z, select = 1, contour = TRUE, n = c(400,400), dist = 0.15) +
theme_classic() +
xlab("Number of sites (log scale)") +
ylab("Relative Z-transformed Closeness Centrality\nin Global Metaweb") +
ggtitle("")+
scale_fill_gradientn(colors=c("lightblue","white", "firebrick"), limits = c(-4, 4), na.value = "gray97")+
theme(legend.position = c(0.95, 0.06),
legend.justification = c("right", "bottom"),
legend.background = element_rect(fill = alpha("gray97", 0.8), colour = NA),
legend.key.height = unit(0.2, "in"),
legend.key.width = unit(0.2, "in"))
#dev.off()
gam_close <- mgcv::gam(scale(close) ~ te(nsites, turnover, k=13), data = meta2turn)
gam.check(gam_close)
??gam.check()
library(mgcv)
gam_close <- mgcv::gam(scale(close) ~ te(nsites, turnover, k=13), data = meta2turn)
gam.check(gam_close)
pdf(file="gamplot.pdf", width=7, height=4)
grid.arrange(gamplot, gamzplot, ncol=2)
dev.off()
bayeClosesum %>% dplyr::filter(., param !="intercept") %>% dplyr::filter(., pMCMC<0.05) #Results for raw metaweb
bayeLocsum %>% dplyr::filter(., param!="intercept") %>% dplyr::filter(., pMCMC<.05)
bayeZsum %>% dplyr::filter(., param != "intercept") %>% dplyr::filter(., pMCMC<0.05) #Results for z-standardized metaweb
save(bayeZsum, bayeLocsum, bayeClosesum, file="densitysummaries.RDA")
#pdf(file="figs/local_bayesplot_full.pdf", width=7, height=11)
localCentbayes %>% dplyr::filter(., param!="intercept") %>%
ggplot(., aes(x = value, y = names, fill=factor(stat(quantile)))) +
stat_density_ridges(scale = 1,
geom = "density_ridges_gradient",
calc_ecdf = TRUE,
quantiles = c(0.025, 0.975),
rel_min_height=0.01
)+
theme_classic()+
geom_vline(xintercept=0, col="red", linetype="dashed")+
facet_wrap(~param, ncol=1,
labeller = as_labeller(c(
geo = "Geographic Range",
env = "Environmental Range",
interaction = "Interaction"
)))+
scale_fill_manual(values = c("lightgrey", "dodgerblue", "lightgrey"))+
guides(fill="none")+
ylab("")+
xlab("Coefficient value")+
theme(axis.text.y=element_text(size=12), strip.text.x = element_text(size = 16))
pdf(file="figs/local_bayesplot_full.pdf", width=7, height=11)
