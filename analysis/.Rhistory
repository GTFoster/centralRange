ggplot(., aes(x = close_scaled, y = close.z, color = turnover)) +
geom_point() + geom_smooth(method="lm") +
scale_color_viridis_c()+theme_classic()+
ggtitle("Insect-Pollinated Plants") +
stat_cor(aes(label = ..rr.label..), label.x = 0, label.y = -4)
